# Copia este archivo como ".env" y rellena tus valores.
# El archivo ".env" NUNCA se sube a GitHub.

# Clave de Google AI Studio (Gemini)
GEMINI_API_KEY=
# Modelo de Gemini. Si lo dejas vacío se usa el valor por defecto de config.py
GEMINI_MODEL=
# Bot de Telegram (creado con @BotFather) y tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# OPCIONAL: clave de Alpha Vantage para noticias adicionales
ALPHAVANTAGE_API_KEY=
